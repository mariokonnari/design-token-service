// Data model for the Design Token service (ADR 0012).
//
// Notes:
// - Ids are native uuids generated by the DATABASE (`gen_random_uuid()`), so
//   rows can be inserted with raw SQL and no sequential id ever appears in a URL.
// - Prisma cannot express CHECK constraints. They live in the migration SQL
//   (slug/path/email formats, Token.type rules, Release.number, Release.cssSha256)
//   and are covered by test/db/constraints.test.ts. `prisma migrate diff` cannot
//   see them, so that test file is their only guard.
// - Delete rules (org deletion is not an API feature in v1, so the rule is
//   "refuse unless clearly safe"):
//     Membership -> User, Organization : Cascade  (a pure join row)
//     Brand -> Organization            : Restrict (never delete an org's brands by accident)
//     Token -> Brand                   : Cascade  (tokens are the brand's mutable draft)
//     Release -> Brand                 : Restrict (releases become immutable published artifacts)
//     Release -> User (createdBy)      : Restrict (keep the audit trail)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum Visibility {
  PRIVATE
  PUBLIC
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  brands      Brand[]
}

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String       @unique
  passwordHash   String
  sessionVersion Int          @default(0)
  createdAt      DateTime     @default(now())
  memberships    Membership[]
  releases       Release[]
}

model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Brand {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  slug           String
  name           String
  visibility     Visibility   @default(PRIVATE)
  // Incremented on every draft change; a Release records the revision it was built from.
  draftRevision  Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokens         Token[]
  releases       Release[]

  @@unique([organizationId, slug])
}

model Token {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId     String   @db.Uuid
  // Dotted path, e.g. "semantic.color.action" (each segment is a slug).
  path        String
  // NULL only for alias tokens, which inherit their target's type (CHECK in the migration).
  type        String?
  value       Json
  description String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, path])
}

model Release {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId        String   @db.Uuid
  number         Int
  // The Brand.draftRevision this release was built from.
  sourceRevision Int
  snapshot       Json
  css            String   @db.Text
  cssSha256      String
  note           String?
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([brandId, number])
  @@index([createdById])
}
