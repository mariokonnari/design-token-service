# Copy to .env (gitignored) for local development: `cp .env.example .env`.
# Loaded only by the dev scripts (node --env-file); `start` and production load no file.
NODE_ENV=development
PORT=3000
# The local database from docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgresql://dts:dts@localhost:5433/dts_dev
# At least 32 characters. There is no default anywhere: generate your own for real use.
SESSION_SECRET=replace-with-at-least-32-random-characters
SIGNUP_ENABLED=true
# Comma-separated origins (scheme + host [+ port], no path). Empty means none.
# Every unsafe request (POST/PATCH/DELETE) must send an Origin from this list.
ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of the app that you trust to set X-Forwarded-For
# (0 = none, as in local development). Too low: all users share one rate limit.
# Too high: clients can forge their IP. Verify on a real deployment (ADR 0013).
TRUST_PROXY=0
